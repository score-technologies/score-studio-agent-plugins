  "author": {
    "name": "Score Technologies"
  },
  "homepage": "https://github.com/score-technologies/score-studio-agent-plugins",
  "repository": "https://github.com/score-technologies/score-studio-agent-plugins",
  "license": "Apache-2.0",
  "keywords": [
    "computer-vision",
    "datasets",
    "annotation",
    "training",
    "evaluation",
    "evidence",
    "workflows",
    "deployment",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": "./mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "SCORESTUDIO_TOKEN": {
        "type": "string",
        "title": "Score Studio token",
